# Service account key used to call the rs-open-source API and download its outputs,
# needs roles/run.invoker on the API and read access to its output bucket.
# Leave empty to use the gcloud login (gcloud auth login) instead.
GOOGLE_APPLICATION_CREDENTIALS="./private_key.json"

# GitHub token to install the private s4g-lib when building the Docker image,
# fine-grained with read-only Contents on space4good/s4g-lib
GH_TOKEN="ghp_"

# URL of the rs-open-source API on Cloud Run that runs the composites, from
# gcloud run services describe rs-open-source-api --region europe-west4 --format "value(status.url)"
RS_API_URL="https://YOUR_RS_API_URL.com"

# NASA Earthdata login for GEDI, HLS and other Earthdata sources for composite
EARTHDATA_USERNAME=""
EARTHDATA_PASSWORD=""

# AWS Copernicus if choosing copernicus as source for composite
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Hugging Face token for the S2 composite omni cloud mask (OmniCloudMask), not needed with cloud_mask="scl"
HF_TOKEN=""
